# Test environment for order-service. Loaded (override: true) by
# tests/setup-env.ts before every test file. NEVER point this at a
# dev/prod database — every DB name below ends in _test.

PORT=4000
NODE_ENV=test

ACCESS_SECRET=test-access-secret-do-not-use-in-prod
REFRESH_SECRET=test-refresh-secret-do-not-use-in-prod
ACCESS_EXPIRES_IN=3600
REFRESH_EXPIRES_IN=604800

CORS_ORIGINS=http://localhost:3000

# Both regions included on purpose — sharding/region-resolver logic gets
# exercised for real, not just unit-tested against a mock.
REGIONS=eg,ksa

DB_POOL_MAX=5
DB_MIGRATION_DIRECTORY=src/migrations
DB_MIGRATION_EXTENSION=ts

# ── Hot cluster — test databases ────────────────────────────────────────────
DB_eg_HOST=localhost
DB_eg_PORT=5432
DB_eg_USERNAME=postgres
DB_eg_PASSWORD=NewStrongPassword123!
DB_eg_NAME=order_service_eg_test

DB_ksa_HOST=localhost
DB_ksa_PORT=5432
DB_ksa_USERNAME=postgres
DB_ksa_PASSWORD=NewStrongPassword123!
DB_ksa_NAME=order_service_ksa_test

# ── Archive cluster — not exercised by Phase 2-5 yet, but env.ts requires
# these to be present to parse at all. Separate _test databases, same as hot.
ARCHIVE_DB_eg_HOST=localhost
ARCHIVE_DB_eg_PORT=5432
ARCHIVE_DB_eg_USERNAME=postgres
ARCHIVE_DB_eg_PASSWORD=NewStrongPassword123!
ARCHIVE_DB_eg_NAME=order_service_archive_eg_test

ARCHIVE_DB_ksa_HOST=localhost
ARCHIVE_DB_ksa_PORT=5432
ARCHIVE_DB_ksa_USERNAME=postgres
ARCHIVE_DB_ksa_PASSWORD=NewStrongPassword123!
ARCHIVE_DB_ksa_NAME=order_service_archive_ksa_test

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ: real local broker, but a dedicated queue/DLQ pair so a test run
# never collides with dev's core-events queue.
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_CORE_EVENTS_EXCHANGE=core.events
RABBITMQ_CORE_EVENTS_QUEUE=order-service.core-events.test
RABBITMQ_CORE_EVENTS_BINDINGS="product.#,branch.#,restaurant.#,rbac.#"
RABBITMQ_CORE_EVENTS_DLX=core.events.dlx
RABBITMQ_CORE_EVENTS_DLQ=order-service.core-events.test.dlq
RABBITMQ_PREFETCH=32

RABBITMQ_ORDER_EVENTS_EXCHANGE=order.events.test
OUTBOUND_EVENTS_DRAIN_TICK_SEC=2
OUTBOUND_EVENTS_BATCH_SIZE=100

# core-service is stubbed entirely in tests (CoreClientStub, see
# tests/helpers/core-client-stub.ts) — never actually dialed. Present only
# because env.ts's schema requires these to parse.
CORE_SERVICE_BASE_URL=http://core-service.test.invalid
CORE_INTERNAL_API_KEY=test-core-internal-api-key
CORE_HTTP_TIMEOUT_MS=5000

INTERNAL_API_KEY=test-internal-api-key

WS_HEARTBEAT_SEC=30

# Kashier is stubbed entirely in tests (KashierProviderStub) — never
# actually dialed. Present only because env.ts's schema requires them.
KASHIER_MERCHANT_ID=test-merchant-id
KASHIER_API_KEY=test-api-key
KASHIER_SECRET_KEY=test-secret-key
KASHIER_RETURN_URL=https://example.com/checkout/success
KASHIER_FAIL_URL=https://example.com/checkout/failure
KASHIER_WEBHOOK_URL=https://example.com/api/payments/webhook/kashier?region=eg
KASHIER_BASE_URL=https://test-api.kashier.io
KASHIER_FEP_BASE_URL=https://test-fep.kashier.io
KASHIER_PAYMENT_TYPE=credit
PAYMENT_SESSION_TIMEOUT_MIN=15
ONLINE_PAYMENT_REGIONS=eg

PRESENCE_STALE_SEC=300
ASSIGNMENT_TICK_SEC=10
ASSIGNMENT_RADIUS_METERS=5000
ASSIGNMENT_CANDIDATES=5
ASSIGNMENT_OFFER_TTL_SEC=30
ASSIGNMENT_CLAIM_TTL_SEC=300
ASSIGNMENT_MAX_ATTEMPTS=3
ASSIGNMENT_BATCH=20
AGENT_EARNING_SHARE_BPS=8000

ARCHIVAL_CRON=0 3 * * *
ARCHIVAL_TIMEZONE=UTC
ARCHIVAL_BATCH_SIZE=1000
ARCHIVAL_MAX_RUNTIME_MIN=60
